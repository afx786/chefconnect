{
  "name": "Booking Confirmation Email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "booking-confirmed",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "id": "webhook-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "booking-confirmed"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-event",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "booking.confirmed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-1",
      "name": "Validate Event",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: $env.RESEND_FROM_EMAIL || 'onboarding@resend.dev', to: $json.body.user_email, subject: 'ChefConnect booking confirmed', html: '<h2>Booking Confirmed</h2><p>Hello ' + $json.body.user_name + ',</p><p>Your ChefConnect booking has been confirmed.</p><table style=\"border-collapse:collapse;margin:16px 0\"><tr><td style=\"padding:6px 12px;font-weight:600\">Chef</td><td style=\"padding:6px 12px\">' + $json.body.chef_name + '</td></tr><tr><td style=\"padding:6px 12px;font-weight:600\">Date</td><td style=\"padding:6px 12px\">' + $json.body.booking_date + '</td></tr><tr><td style=\"padding:6px 12px;font-weight:600\">Meal</td><td style=\"padding:6px 12px\">' + $json.body.meal_slot + '</td></tr><tr><td style=\"padding:6px 12px;font-weight:600\">Booking ID</td><td style=\"padding:6px 12px\">#' + $json.body.booking_id + '</td></tr><tr><td style=\"padding:6px 12px;font-weight:600\">Status</td><td style=\"padding:6px 12px\">' + $json.body.status + '</td></tr></table><p>We look forward to serving you.</p>' }) }}",
        "options": {}
      },
      "id": "resend-1",
      "name": "Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 240],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Resend API Key"
        }
      }
    },
    {
      "parameters": {},
      "id": "noop-1",
      "name": "Ignore Other Events",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [720, 420]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Validate Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Event": {
      "main": [
        [
          {
            "node": "Resend",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ignore Other Events",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
  "tags": []
}
