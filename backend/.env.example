# PostgreSQL database connection
# Replace with your local credentials. Never commit a real .env file.
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/chefconnect

# JWT authentication
# JWT_SECRET_KEY has no insecure fallback in production: when ENVIRONMENT=production
# the application refuses to start unless this is set to a unique 32+ character value.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Runtime environment: "development" or "production"
ENVIRONMENT=development

# Redis (rate limiting; will also back caching in a later milestone)
REDIS_URL=redis://localhost:6379/0

# Rate limiting (fixed window per client)
# RATE_LIMIT_ENABLED=false disables all limiters (useful for tests).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX_REQUESTS=5
RATE_LIMIT_BOOKINGS_MAX_REQUESTS=10
RATE_LIMIT_CHEFS_MAX_REQUESTS=60

# Chef discovery caching (TTL in seconds; set to 0 to disable caching)
CHEFS_CACHE_TTL_SECONDS=60

# n8n webhook for booking confirmation events
# Set this to your n8n webhook production/test URL.
# Leave empty to disable webhook delivery.
N8N_BOOKING_CONFIRMED_WEBHOOK_URL=

# Resend email delivery (used by n8n workflow)
# Do NOT commit real API keys. Set these in your local .env.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
